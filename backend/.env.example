# Copy this file to .env and adjust as needed. Every value here has a
# sensible default already baked into app/core/config.py, so the app runs
# fine with NO .env file at all - this is only for overrides.

# Database - SQLite needs no setup and is the default. Switch to Postgres
# only if you actually run a Postgres server (e.g. via docker-compose).
DATABASE_URL=sqlite:///./legal_metrix.db
# DATABASE_URL=postgresql://Nirikshan:Nirikshan@localhost:5432/legal_metrix

# Security - CHANGE THIS before deploying anywhere other than your laptop.
SECRET_KEY=change-this-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# File storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# OCR: real OCR is used automatically if pytesseract + the Tesseract
# system binary are installed; otherwise the app falls back to DEMO MODE.
OCR_ENGINE=tesseract

# Redis (optional - not required to run the app today)
REDIS_URL=redis://localhost:6379
